#!/usr/bin/env ruby
# Source of truth for data/raw/ and data/samples/upload-demo/: HTML -> docx (-> pdf). Never edit the binaries by hand.
require "open3"
require "yaml"
require "fileutils"
require "tmpdir"
$LOAD_PATH.unshift("src")
require "rag"

LO = ["soffice", "--headless", "-env:UserInstallation=file:///tmp/lo-profile"].freeze

# Converts into a fresh dir and aborts unless the expected file appears, so a stale file is never reused.
def convert(src, format, dir, infilter: nil)
  cmd = ["timeout", "120", *LO, *(infilter ? ["--infilter=#{infilter}"] : []), "--convert-to", format, "--outdir", dir, src]
  out, err, st = Open3.capture3(*cmd)
  produced = File.join(dir, "#{File.basename(src, '.*')}.#{format}")
  abort "FAIL converting #{src} to #{format}: #{out[0, 300]} #{err[0, 300]}" unless st.success? && File.exist?(produced)
  produced
end

failed = false
YAML.safe_load_file("data/samples/manifest.yml", symbolize_names: true).each do |m|
  Dir.mktmpdir("build-sample") do |dir|
    built = convert("data/samples/src/#{m[:src]}", "docx", dir, infilter: "HTML (StarWriter)")
    built = convert(built, "pdf", dir) if File.extname(m[:out]) == ".pdf"
    FileUtils.mkdir_p(File.dirname(m[:out]))
    FileUtils.mv(built, m[:out])
  end
  pages = Rag::Extract.pages(m[:out])
  ok = pages.size >= 3 && pages.all?(&:readable)
  failed ||= !ok
  puts "#{ok ? 'built' : 'FAILED'} #{m[:out]} (#{pages.size} pages)"
end
exit(failed ? 1 : 0)
