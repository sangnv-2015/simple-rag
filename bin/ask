#!/usr/bin/env ruby
$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "rag"

$stdout.sync = true
question = ARGV.join(" ")
if question.strip.empty?
  warn 'Cách dùng: bin/ask "câu hỏi"'
  exit 2
end
begin
  sys = Rag.build
rescue Rag::ConfigError => e
  warn e.message
  exit 2
end
streamed = false
begin
  answer = sys.ask.call(question) { |d| streamed = true; print d }
rescue Rag::Error => e
  puts if streamed
  warn e.message
  exit 1
end
if answer.found
  puts
  answer.sources.each do |s|
    puts "[#{s.n}] #{s.filename} · trang #{s.page}#{s.quote ? " — \"#{s.quote}\"" : " — không xác minh được đoạn trích"}"
  end
else
  # Streamed text (if any) is not erased: the not-found line goes on its own line after it.
  puts if streamed
  puts "Không tìm thấy thông tin này trong tài liệu."
end
