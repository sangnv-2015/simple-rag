DEEPSEEK_API_KEY=
# replace with the company endpoint, no trailing slash
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# optional: extra host(s) allowed besides localhost, e.g. an ngrok domain (comma-separated)
