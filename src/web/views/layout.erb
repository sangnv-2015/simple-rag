<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<% if @refresh %><meta http-equiv="refresh" content="3"><% end %>
<title>Hỏi đáp tài liệu</title>
<style>
  :root {
    --bg: #f7f8fa; --surface: #fff; --sidebar: #f1f3f6; --border: #e3e6eb; --border-strong: #cfd4dc;
    --text: #1a1f2b; --muted: #5b6475; --primary: #2453c7; --primary-hover: #1c43a6; --primary-soft: #e8eefb;
    --hl: #fde68a; --warn-bg: #fff7e0; --warn: #b7791f; --danger: #c62828;
    --shadow: 0 1px 2px rgba(16,24,40,.06), 0 1px 3px rgba(16,24,40,.08);
    --topbar-h: 3.5rem;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; }
  body { font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; font-size: 16px; line-height: 1.6; color: var(--text); background: var(--bg); -webkit-font-smoothing: antialiased; }
  a { color: var(--primary); }
  :focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  /* top bar */
  .topbar { height: var(--topbar-h); display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0 1.25rem; background: var(--surface); border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 10; }
  .brand { display: flex; align-items: center; gap: .6rem; margin: 0; font-size: 1.05rem; font-weight: 650; letter-spacing: -.01em; white-space: nowrap; }
  .brand-mark { display: grid; place-items: center; flex: none; width: 2rem; height: 2rem; border-radius: 8px; background: var(--primary); color: #fff; }
  .topnav { display: flex; gap: .25rem; }
  .topnav a { padding: .45rem .8rem; border-radius: 8px; color: var(--muted); text-decoration: none; font-weight: 500; font-size: .95rem; transition: background .15s, color .15s; }
  .topnav a:hover { background: var(--sidebar); color: var(--text); }
  .topnav a[aria-current] { background: var(--primary-soft); color: var(--primary); }

  /* generic pages (documents) */
  .page-wrap { max-width: 70rem; margin: 0 auto; padding: 1.5rem 1.25rem 3rem; }
  body:has(.app) .page-wrap { max-width: none; padding: 0; }
  button { padding: .6rem 1.2rem; font: inherit; font-weight: 600; border: 0; border-radius: 10px; background: var(--primary); color: #fff; cursor: pointer; transition: background .15s, opacity .15s; }
  button:hover { background: var(--primary-hover); }
  button:disabled { opacity: .5; cursor: wait; }
  .note { background: var(--warn-bg); border: 1px solid #f3d98b; padding: .6rem .9rem; border-radius: 8px; }
  .meta { color: var(--muted); font-size: .875rem; }
  mark { background: var(--hl); padding: 0 .1em; border-radius: 2px; }
  details { margin: .5rem 0; } summary { cursor: pointer; color: var(--muted); }
  table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
  th, td { text-align: left; padding: .4rem .6rem; border-bottom: 1px solid var(--border); }
  th { font-size: .85rem; color: var(--muted); font-weight: 600; }
  .cols { display: flex; flex-wrap: wrap; gap: 1rem; }
  .cols > div { flex: 1 1 22rem; min-width: 0; }
  pre { white-space: pre-wrap; overflow-wrap: anywhere; background: var(--sidebar); padding: .6rem; margin: .25rem 0; border-radius: 6px; }
  .page { margin: 1.5rem 0; padding: .75rem 1rem; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; }
  .page.current { border: 2px solid var(--warn); background: #fffaf0; }
  .flag { background: var(--warn-bg); padding: .25rem .5rem; border-radius: 4px; }

  /* chat app shell */
  .app { display: grid; grid-template-columns: 17rem minmax(0, 1fr); height: calc(100vh - var(--topbar-h)); height: calc(100dvh - var(--topbar-h)); }
  .sidebar { display: flex; flex-direction: column; gap: .75rem; padding: 1rem .75rem; background: var(--sidebar); border-right: 1px solid var(--border); min-height: 0; }
  .btn-new { display: flex; align-items: center; justify-content: center; gap: .5rem; width: 100%; min-height: 44px; background: var(--surface); color: var(--text); border: 1px solid var(--border-strong); box-shadow: var(--shadow); }
  .btn-new:hover { background: var(--primary-soft); color: var(--primary); border-color: var(--primary); }
  #sidebar { margin: 0; display: flex; flex-direction: column; min-height: 0; }
  #sidebar > summary { list-style: none; padding: .25rem .5rem; font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  #sidebar > summary::-webkit-details-marker { display: none; }
  #sidebar-list { list-style: none; padding: 0; margin: .25rem 0 0; overflow-y: auto; min-height: 0; max-height: calc(100dvh - 12rem); }
  #sidebar-list:empty::before { content: "Chưa có hội thoại nào"; display: block; padding: .5rem; color: var(--muted); font-size: .875rem; }
  #sidebar-list li { display: flex; align-items: center; border-radius: 8px; transition: background .15s; }
  #sidebar-list li:hover { background: #e6e9ef; }
  #sidebar-list li:has(.active) { background: var(--surface); box-shadow: var(--shadow); }
  #sidebar-list .chat-item { flex: 1; min-width: 0; min-height: 40px; text-align: left; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; background: none; border: 0; border-radius: 8px; padding: .45rem .6rem; color: var(--text); font-weight: 400; font-size: .925rem; }
  #sidebar-list .chat-item.active { font-weight: 600; }
  #sidebar-list .chat-del { flex: none; width: 32px; height: 32px; padding: 0; margin-right: 4px; background: none; border-radius: 6px; color: var(--muted); font-size: 1.15rem; font-weight: 400; line-height: 1; opacity: 0; }
  #sidebar-list li:hover .chat-del, #sidebar-list .chat-del:focus-visible, #sidebar-list li:has(.active) .chat-del { opacity: 1; }
  #sidebar-list .chat-del:hover { background: #fde8e8; color: var(--danger); }
  @media (hover: none) { #sidebar-list .chat-del { opacity: 1; } }

  .chat-main { display: flex; flex-direction: column; min-height: 0; background: var(--surface); }
  #chat { flex: 1; overflow-y: auto; padding: 2rem 1.25rem 1rem; }
  #chat > .turn, .welcome > *, .composer-inner, .chat-main > .note { max-width: 46rem; margin-left: auto; margin-right: auto; }
  .chat-main > .note { margin-top: 1rem; width: calc(100% - 2.5rem); }
  .welcome { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 2rem 1.25rem; color: var(--muted); }
  .welcome h2 { margin: .75rem auto .25rem; font-size: 1.5rem; color: var(--text); letter-spacing: -.02em; }
  .welcome p { margin: 0 auto; max-width: 30rem; }
  .welcome .brand-mark { width: 3rem; height: 3rem; border-radius: 12px; }
  #chat:not(:empty) ~ .welcome { display: none; }
  #chat:empty { flex: 0; padding: 0; }

  .turn { margin-bottom: 2rem; }
  .turn .question { width: fit-content; max-width: 85%; margin: 0 0 1rem auto; padding: .6rem 1rem; border-radius: 16px 16px 4px 16px; background: var(--primary); color: #fff; font-weight: 500; white-space: pre-wrap; overflow-wrap: anywhere; }
  .turn > .meta { margin: -.5rem 0 .5rem; font-style: italic; }
  .answer { overflow-wrap: anywhere; }
  .answer > :first-child { margin-top: 0; }
  .answer p, .answer ul, .answer ol { margin: .5rem 0 .75rem; }
  .answer h4 { margin: 1rem 0 .25rem; font-size: 1rem; }
  .answer table { font-size: .925rem; display: block; overflow-x: auto; }
  .answer tr:first-child td { font-weight: 600; background: var(--bg); }
  .answer[aria-live] > .meta::after { content: ""; display: inline-block; width: .5em; height: .5em; margin-left: .5em; border-radius: 50%; background: var(--primary); animation: pulse 1s ease-in-out infinite; vertical-align: middle; }
  @keyframes pulse { 50% { opacity: .2; } }
  @media (prefers-reduced-motion: reduce) { .answer[aria-live] > .meta::after { animation: none; } }
  .cite { display: inline-block; min-width: 1.35em; padding: 0 .3em; margin: 0 .1em; border-radius: 5px; background: var(--primary-soft); color: var(--primary); font-size: .72em; font-weight: 700; text-align: center; text-decoration: none; vertical-align: super; line-height: 1.5; }
  a.cite:hover { background: var(--primary); color: #fff; }
  .turn h3 { margin: 1.25rem 0 .5rem; font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  .sources { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: .6rem; padding: 0; margin: 0; list-style: none; }
  .source { min-width: 0; background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: .65rem .85rem; transition: border-color .15s, box-shadow .15s; }
  .source:hover { border-color: var(--border-strong); box-shadow: var(--shadow); }
  .source:target { border-color: var(--warn); box-shadow: 0 0 0 3px #fde9b8; }
  .source > a { font-weight: 600; font-size: .9rem; text-decoration: none; color: var(--text); word-break: break-all; }
  .source > a:hover { color: var(--primary); }
  .source > a .cite { vertical-align: baseline; font-size: .7rem; }
  .source .meta { font-size: .8rem; }
  .source blockquote { margin: .4rem 0 0; padding: .1rem 0 .1rem .65rem; border-left: 3px solid var(--hl); color: var(--muted); font-size: .85rem; max-height: 6.5em; overflow: auto; }

  .scope-bar { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1rem; padding: .6rem 1.25rem; border-bottom: 1px solid var(--border); font-size: .9rem; }
  .scope-bar select { font: inherit; padding: .25rem .4rem; }
  #scope { display: flex; flex-wrap: wrap; gap: .25rem 1rem; }
  #scope p, #scope-msg { margin: 0; }
  #scope-msg { color: var(--danger); flex-basis: 100%; }
  .chunks .chunk { margin: .4rem 0; } .chunks pre { max-height: 10rem; overflow: auto; font-size: .85rem; }
  .composer { padding: .75rem 1.25rem 1rem; }
  .composer-inner { display: flex; align-items: center; gap: .5rem; padding: .4rem .4rem .4rem 1rem; background: var(--surface); border: 1px solid var(--border-strong); border-radius: 16px; box-shadow: 0 4px 16px rgba(16,24,40,.08); transition: border-color .15s, box-shadow .15s; }
  .composer-inner:focus-within { border-color: var(--primary); box-shadow: 0 0 0 3px var(--primary-soft), 0 4px 16px rgba(16,24,40,.08); }
  .composer input { flex: 1; min-width: 0; min-height: 44px; border: 0; outline: 0; background: none; font: inherit; color: var(--text); }
  .composer input::placeholder { color: #7a8394; }
  .composer button { min-height: 44px; }
  .composer .hint { margin: .4rem 0 0; text-align: center; font-size: .75rem; color: var(--muted); }

  @media (max-width: 48rem) {
    .app { grid-template-columns: 1fr; grid-template-rows: auto minmax(0, 1fr); }
    .sidebar { flex-direction: row; flex-wrap: wrap; align-items: center; border-right: 0; border-bottom: 1px solid var(--border); padding: .5rem .75rem; }
    .btn-new { width: auto; order: 2; min-height: 40px; padding: .4rem .9rem; }
    #sidebar { flex: 1; }
    #sidebar > summary { padding: .6rem .25rem; }
    #sidebar[open] { flex-basis: 100%; order: 3; }
    #sidebar-list { max-height: 9rem; }
    #chat { padding: 1.25rem 1rem .5rem; }
    .composer { padding: .5rem .75rem .75rem; }
    .topbar { padding: 0 .75rem; }
    .brand-text { display: none; }
  }
</style>
</head>
<body>
<header class="topbar">
  <p class="brand"><span class="brand-mark" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8M8 17h5"/></svg></span><span class="brand-text">Hỏi đáp tài liệu</span></p>
  <nav class="topnav" aria-label="Chính">
    <a href="/"<%= ' aria-current="page"' if request.path_info == "/" %>>Hỏi đáp</a>
    <a href="/documents"<%= ' aria-current="page"' if request.path_info.start_with?("/documents") %>>Tài liệu</a>
  </nav>
</header>
<main class="page-wrap">
<%= yield %>
</main>
</body>
</html>
